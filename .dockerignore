# Secrets and local state — must never enter the image.
#
# Patterns are anchored at the context root unless they begin with **, so a bare
# `.env` would exclude ./.env while letting frontend/.env through. That matters
# most for the frontend: Vite inlines VITE_* variables into the JS bundle at
# build time, so a leaked value would be served to every browser rather than
# merely sitting in a file.
**/.env
**/.env.*
!**/.env.example

# Local database and runtime output
**/*.db
**/*.db-wal
**/*.db-shm
**/shopping.md
**/uge_*.yaml

# VCS and worktrees
.git
.gitignore
.jj
.worktrees/

# Frontend: sources are copied into the build stage explicitly; never ship
# host-built artifacts or dependencies into the runtime image.
frontend/node_modules/
frontend/dist/
node_modules/

# Python environments and caches
.venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Heavy material that has no place in a runtime image
archive/
docs/
.agents/
.trufflehog/
*.ipynb
.ipynb_checkpoints/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
