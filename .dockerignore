# Secrets and local state — must never enter the image
.env
.env.*
!.env.example

# Local database and runtime output
*.db
*.db-wal
*.db-shm
recipes.db
shopping.md
uge_*.yaml

# VCS and worktrees
.git
.gitignore
.jj
.worktrees/

# Frontend: sources are copied into the build stage explicitly; never ship
# host-built artifacts or dependencies into the runtime image.
frontend/node_modules/
frontend/dist/
node_modules/

# Python environments and caches
.venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Heavy material that has no place in a runtime image
archive/
docs/
.agents/
.trufflehog/
*.ipynb
.ipynb_checkpoints/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
